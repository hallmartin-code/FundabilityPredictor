# Copy to .env for local development, or set these as Railway variables.
# .env is gitignored. Never commit a real key.

# --- Claude extraction --------------------------------------------------------
# Claude reads the deck and locates fields the rule-based extractor cannot.
# Every value it returns is checked against a verbatim quote from the source
# before being accepted, and the scoring model stays deterministic either way.
ANTHROPIC_API_KEY=

# off  - never call the API (default; fully deterministic, no cost)
# auto - enable when ANTHROPIC_API_KEY is present
# on   - always attempt to enable
FP_LLM_ENABLED=off

FP_LLM_MODEL=claude-opus-5
# Extraction effort: low | medium | high | xhigh | max.
# "high" is the most accurate; "medium" roughly halves latency and cost.
FP_LLM_EFFORT=high

# --- Web app ------------------------------------------------------------------
# Set a password on any public deployment: each analysis calls a paid API, so
# an open URL is an open billing endpoint. Unset means no gate (local only).
FP_ACCESS_PASSWORD=

FP_MAX_UPLOAD_MB=40
FP_MAX_CONCURRENT=2
# Where uploaded decks and generated reports are held before expiry.
# Leave unset to use a temporary directory.
FP_JOB_DIR=

# --- Email notifications (Resend) ---------------------------------------------
# Results are emailed after every analysis, with the PDF and lead record
# attached. Delivery is best-effort: a mail failure never fails an analysis.
RESEND_API_KEY=

# off  - never send (default)
# auto - send when RESEND_API_KEY is present
# on   - always attempt to send
FP_EMAIL_ENABLED=off

FP_EMAIL_TO=Info@tencapital.group
# Comma-separated for several recipients: a@x.com,b@y.com

# IMPORTANT: Resend's default sender (onboarding@resend.dev) only delivers to
# the Resend account owner's own address. To reach a team mailbox you must
# verify a domain at resend.com/domains and set a sender on that domain:
#   FP_EMAIL_FROM=TEN Capital Reports <reports@tencapital.group>
FP_EMAIL_FROM=
FP_EMAIL_REPLY_TO=

# Which artifacts to attach: pdf, data, evidence, html
FP_EMAIL_ATTACH=pdf,data
# Also email when an analysis fails, so a silent drop is never the outcome.
FP_EMAIL_ON_FAILURE=on

# --- Model assumptions --------------------------------------------------------
# Capital market environment. One of:
#   highly_favorable | favorable | neutral | difficult | highly_difficult
# There is no live market feed, so this is always reported as an ASSUMPTION.
FP_MARKET_CONDITION=neutral

# --- Output -------------------------------------------------------------------
FP_OUTPUT_DIR=output
FP_PAGE_SIZE=LETTER          # LETTER or A4
FP_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
